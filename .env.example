# Copy to .env.local (never commit it). Both values are in Supabase → Project Settings → API.
# The anon key is public by design — row-level security in the database is what protects your data.
# Leave these empty and the app asks for them once, on first launch.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
